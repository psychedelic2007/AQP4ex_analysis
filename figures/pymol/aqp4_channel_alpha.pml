rebuild
hide everything, aqp4
show cartoon, aqp4
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp4 and resi 2-22+24-34+36-58+60-211+213-230+232-233+235-323
color grey70, aqp4
spectrum b, white_blue, fel_scored, minimum=0.0, maximum=1.8865031212514332

select fel_significant, aqp4 and resi 4-7+9-20+22+24-29+31-34+36-58+60-115+117-211+213-230+232-233+235-322
# show sticks, fel_significant and not name N+C+O
deselect
orient aqp4 and resi 2-323

print "AQP4 channel alpha: 0.000 to 1.887 - shared by alpha and beta"
print "316 coloured / 22 clipped / 309 significant (BH q <= 0.20)"

