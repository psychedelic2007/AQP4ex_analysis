rebuild
hide everything, aqp5
show cartoon, aqp5
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp5 and resi 2-34+36-123+125-183+185-203+205-206+208-265
color grey70, aqp5
spectrum b, red_white_blue, fel_scored, minimum=-4.0, maximum=4.0

select fel_significant, aqp5 and resi 3-7+9-21+23-33+36-46+48-87+89-118+120-123+125-183+185-195+198-203+205-206+208-214+216-235+237-238+240-258+260-265
# show sticks, fel_significant and not name N+C+O
deselect
orient aqp5 and resi 2-265

print "AQP5 channel omega: log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16) - white at omega = 1"
print "259 coloured / 150 clipped / 246 significant (BH q <= 0.20)"

