# PyMOL: AQP4 extension, coloured by beta (non-synonymous substitution rate)
# generated by fel_to_pymol.py from results_final/aqp4/fel/joint_mafft.json (extension module)
#
# Reading: red = amino-acid changes were removed
# Colour scale : 0.000 to 1.887, shared by alpha and beta
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.0127 to 1.05 over 28 coloured sites,
#                0 clipped at the scale limit
# Rows         : 28 human residues (28 tested). 31 columns
#                are gaps in human and are not drawn, 0 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 16 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -324
#                (325 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp4_tail_beta_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp4     # skip if --pdb was given
#   @aqp4_tail_beta.pml

alter aqp4, b = 0.0
alter aqp4 and resi 1, b = 0.0608
alter aqp4 and resi 2, b = 0.2789
alter aqp4 and resi 3, b = 0.3841
alter aqp4 and resi 4, b = 0.3310
alter aqp4 and resi 5, b = 0.1854
alter aqp4 and resi 6, b = 0.1549
alter aqp4 and resi 7, b = 0.3254
alter aqp4 and resi 8, b = 0.2197
alter aqp4 and resi 9, b = 0.4932
alter aqp4 and resi 10, b = 0.6622
alter aqp4 and resi 11, b = 0.4642
alter aqp4 and resi 12, b = 0.9780
alter aqp4 and resi 13, b = 0.5382
alter aqp4 and resi 14, b = 1.0496
alter aqp4 and resi 15, b = 0.5607
alter aqp4 and resi 16, b = 0.5251
alter aqp4 and resi 17, b = 0.4328
alter aqp4 and resi 18, b = 0.5364
alter aqp4 and resi 19, b = 0.3765
alter aqp4 and resi 20, b = 0.3800
alter aqp4 and resi 21, b = 0.2630
alter aqp4 and resi 22, b = 0.1550
alter aqp4 and resi 23, b = 0.1072
alter aqp4 and resi 24, b = 0.0258
alter aqp4 and resi 25, b = 0.0127
alter aqp4 and resi 26, b = 0.0758
alter aqp4 and resi 27, b = 0.0444
alter aqp4 and resi 28, b = 0.0871

rebuild
hide everything, aqp4
show cartoon, aqp4
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp4 and resi 1-28
color grey70, aqp4
spectrum b, red_white, fel_scored, minimum=0.0, maximum=1.8865031212514332

select fel_significant, aqp4 and resi 3+6+9-11+16+19-28
show sticks, fel_significant and not name N+C+O
deselect
orient aqp4 and resi 1-28

print "AQP4 extension beta: 0.000 to 1.887 - shared by alpha and beta"
print "28 coloured / 0 clipped / 16 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp4_tail_beta.png, dpi=300
