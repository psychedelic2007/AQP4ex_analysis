# PyMOL: AQP8 extension, coloured by beta (non-synonymous substitution rate)
# generated by fel_to_pymol.py from results_final/aqp8/fel/joint_mafft.json (extension module)
#
# Reading: red = amino-acid changes were removed
# Colour scale : 0.000 to 1.887, shared by alpha and beta
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.103 to 1.99 over 19 coloured sites,
#                2 clipped at the scale limit
# Rows         : 19 human residues (19 tested). 486 columns
#                are gaps in human and are not drawn, 4 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 4 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -262
#                (263 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp8_tail_beta_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp8     # skip if --pdb was given
#   @aqp8_tail_beta.pml

alter aqp8, b = 0.0
alter aqp8 and resi 1, b = 0.5564
alter aqp8 and resi 2, b = 1.0628
alter aqp8 and resi 3, b = 1.0749
alter aqp8 and resi 4, b = 0.9928
alter aqp8 and resi 5, b = 1.3688
alter aqp8 and resi 6, b = 1.2229
alter aqp8 and resi 7, b = 0.1979
alter aqp8 and resi 8, b = 1.1794
alter aqp8 and resi 9, b = 0.8839
alter aqp8 and resi 10, b = 0.1028
alter aqp8 and resi 11, b = 1.7819
alter aqp8 and resi 12, b = 1.7946
alter aqp8 and resi 13, b = 1.1050
alter aqp8 and resi 14, b = 1.7108
alter aqp8 and resi 15, b = 1.2062
alter aqp8 and resi 16, b = 0.2646
alter aqp8 and resi 17, b = 1.8865
alter aqp8 and resi 18, b = 1.8865
alter aqp8 and resi 19, b = 1.4843

rebuild
hide everything, aqp8
show cartoon, aqp8
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp8 and resi 1-19
color grey70, aqp8
spectrum b, red_white, fel_scored, minimum=0.0, maximum=1.8865031212514332

select fel_significant, aqp8 and resi 7+10+15-16
show sticks, fel_significant and not name N+C+O
deselect
orient aqp8 and resi 1-19

print "AQP8 extension beta: 0.000 to 1.887 - shared by alpha and beta"
print "19 coloured / 2 clipped / 4 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp8_tail_beta.png, dpi=300
