# PyMOL: AQP4 extension, coloured by omega (beta/alpha, shown as log2)
# generated by fel_to_pymol.py from results_final/aqp4/fel/joint_mafft.json (extension module)
#
# Reading: red = purifying (omega < 1), white = neutral, blue = diversifying
# Colour scale : log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16), white at omega = 1
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.0162 to 2.08 over 28 coloured sites,
#                3 clipped at the scale limit
# Rows         : 28 human residues (28 tested). 31 columns
#                are gaps in human and are not drawn, 0 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 16 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -324
#                (325 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp4_tail_omega_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp4     # skip if --pdb was given
#   @aqp4_tail_omega.pml

alter aqp4, b = 0.0
alter aqp4 and resi 1, b = 1.0593
alter aqp4 and resi 2, b = -0.2492
alter aqp4 and resi 3, b = -1.8547
alter aqp4 and resi 4, b = 0.1531
alter aqp4 and resi 5, b = -0.1864
alter aqp4 and resi 6, b = -1.8575
alter aqp4 and resi 7, b = -0.1286
alter aqp4 and resi 8, b = -0.5966
alter aqp4 and resi 9, b = -1.6606
alter aqp4 and resi 10, b = -1.3212
alter aqp4 and resi 11, b = -0.7079
alter aqp4 and resi 12, b = -0.1977
alter aqp4 and resi 13, b = -0.2160
alter aqp4 and resi 14, b = -0.4635
alter aqp4 and resi 15, b = 0.4802
alter aqp4 and resi 16, b = -0.6314
alter aqp4 and resi 17, b = 0.0531
alter aqp4 and resi 18, b = -0.1472
alter aqp4 and resi 19, b = -0.8220
alter aqp4 and resi 20, b = -1.1018
alter aqp4 and resi 21, b = -1.8152
alter aqp4 and resi 22, b = -2.3913
alter aqp4 and resi 23, b = -2.4981
alter aqp4 and resi 24, b = -4.0000
alter aqp4 and resi 25, b = -4.0000
alter aqp4 and resi 26, b = -3.1203
alter aqp4 and resi 27, b = -4.0000
alter aqp4 and resi 28, b = -3.7792

rebuild
hide everything, aqp4
show cartoon, aqp4
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp4 and resi 1-28
color grey70, aqp4
spectrum b, red_white_blue, fel_scored, minimum=-4.0, maximum=4.0

select fel_significant, aqp4 and resi 3+6+9-11+16+19-28
show sticks, fel_significant and not name N+C+O
deselect
orient aqp4 and resi 1-28

print "AQP4 extension omega: log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16) - white at omega = 1"
print "28 coloured / 3 clipped / 16 significant (BH q <= 0.20)"

