rebuild
hide everything, aqp8
show cartoon, aqp8
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp8 and resi 7-223+225-227+229-230+232-259
color grey70, aqp8
spectrum b, white_blue, fel_scored, minimum=0.0, maximum=1.8865031212514332

select fel_significant, aqp8 and resi 8-13+16-17+19+21+23-29+31-38+40-59+61+63-78+80-106+108-121+123-137+139-151+153+155-158+160-163+165-173+175-178+180-181+183-208+210-223+225-227+229-230+232-242+244-259
# show sticks, fel_significant and not name N+C+O
deselect
orient aqp8 and resi 7-259

print "AQP8 channel alpha: 0.000 to 1.887 - shared by alpha and beta"
print "250 coloured / 10 clipped / 227 significant (BH q <= 0.20)"

