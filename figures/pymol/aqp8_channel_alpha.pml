# PyMOL: AQP8 channel, coloured by alpha (synonymous substitution rate)
# generated by fel_to_pymol.py from results_final/aqp8/fel/joint_mafft.json (channel module)
#
# Reading: blue = substitutions reached this site freely. Alpha is the internal control: low beta is evidence only where alpha is high
# Colour scale : 0.000 to 1.887, shared by alpha and beta
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.0113 to 3.6 over 250 coloured sites,
#                10 clipped at the scale limit
# Rows         : 261 human residues (250 tested). 0 columns
#                are gaps in human and are not drawn, 0 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : off (227 significant, BH q <= 0.20, --sticks on to draw)
# Numbering    : structure resi = human reference number +0
#                (1 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp8_channel_alpha_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp8     # skip if --pdb was given
#   @aqp8_channel_alpha.pml

alter aqp8, b = 0.0
alter aqp8 and resi 7, b = 0.0113
alter aqp8 and resi 8, b = 1.1126
