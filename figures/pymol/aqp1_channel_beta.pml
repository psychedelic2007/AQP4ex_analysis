rebuild
hide everything, aqp1
show cartoon, aqp1
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp1 and resi 2-10+12-209+211-212+214-269
color grey70, aqp1
spectrum b, red_white, fel_scored, minimum=0.0, maximum=1.8865031212514332

select fel_significant, aqp1 and resi 2-10+12-21+23-45+47-94+97-114+116-127+129-130+132-209+211-212+214-234+236-241+243-244+246-259+261-269
# show sticks, fel_significant and not name N+C+O
deselect
orient aqp1 and resi 2-269

print "AQP1 channel beta: 0.000 to 1.887 - shared by alpha and beta"
print "265 coloured / 0 clipped / 254 significant (BH q <= 0.20)"

