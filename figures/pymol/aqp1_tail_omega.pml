# PyMOL: AQP1 extension, coloured by omega (beta/alpha, shown as log2)
# generated by fel_to_pymol.py from results_final/aqp1/fel/joint_mafft.json (extension module)
#
# Reading: red = purifying (omega < 1), white = neutral, blue = diversifying
# Colour scale : log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16), white at omega = 1
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.164 to 15 over 21 coloured sites,
#                0 clipped at the scale limit
# Rows         : 85 human residues (21 tested). 355 columns
#                are gaps in human and are not drawn, 0 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 10 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -270
#                (271 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp1_tail_omega_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp1     # skip if --pdb was given
#   @aqp1_tail_omega.pml

alter aqp1, b = 0.0
alter aqp1 and resi 1, b = -0.7778
alter aqp1 and resi 2, b = -1.5174
alter aqp1 and resi 3, b = 0.3842
alter aqp1 and resi 4, b = -0.3480
alter aqp1 and resi 5, b = -0.1747
alter aqp1 and resi 6, b = -1.0257
alter aqp1 and resi 10, b = -1.4891
alter aqp1 and resi 12, b = -0.5968
alter aqp1 and resi 13, b = -2.6092
alter aqp1 and resi 14, b = 0.4195
alter aqp1 and resi 15, b = -1.7790
alter aqp1 and resi 16, b = -0.8559
alter aqp1 and resi 17, b = 0.2240
alter aqp1 and resi 18, b = 0.2598
alter aqp1 and resi 19, b = -0.0845
alter aqp1 and resi 20, b = 0.6065
alter aqp1 and resi 21, b = 1.8336
alter aqp1 and resi 27, b = 3.9026
alter aqp1 and resi 28, b = 2.7095
alter aqp1 and resi 29, b = 0.4302
alter aqp1 and resi 30, b = -0.9328

rebuild
hide everything, aqp1
show cartoon, aqp1
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp1 and resi 1-6+10+12-21+27-30
color grey70, aqp1
spectrum b, red_white_blue, fel_scored, minimum=-4.0, maximum=4.0

select fel_significant, aqp1 and resi 2+6+10+13+15-16+21+27-28+30
show sticks, fel_significant and not name N+C+O
deselect
orient aqp1 and resi 1-30

print "AQP1 extension omega: log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16) - white at omega = 1"
print "21 coloured / 0 clipped / 10 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp1_tail_omega.png, dpi=300
