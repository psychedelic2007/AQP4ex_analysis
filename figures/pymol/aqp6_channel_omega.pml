rebuild
hide everything, aqp6
show cartoon, aqp6
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp6 and resi 5-47+49-73+75-153+155-186+188-194+196-213+215-216+218-255+258-282
color grey70, aqp6
spectrum b, red_white_blue, fel_scored, minimum=-4.0, maximum=4.0

select fel_significant, aqp6 and resi 8+11+19-24+26-31+34-41+43-46+49-61+63+65-71+73+75+77-88+90-100+103+105-116+118-123+125-126+128+130-135+138-141+143-153+155-173+175-186+189-191+193-194+196-204+206-210+212-213+215-216+218-229+231-233+235-241+243-252+254+260+262+264-265+267+271+275-278+280-281
# show sticks, fel_significant and not name N+C+O
deselect
orient aqp6 and resi 5-282

print "AQP6 channel omega: log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16) - white at omega = 1"
print "269 coloured / 80 clipped / 214 significant (BH q <= 0.20)"

