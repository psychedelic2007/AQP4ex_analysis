alter aqp2 and resi 271, b = -3.0662

rebuild
hide everything, aqp2
show cartoon, aqp2
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp2 and resi 1-33+35-92+94-182+184-201+203-204+206-245+247-268+270-271
color grey70, aqp2
spectrum b, red_white_blue, fel_scored, minimum=-4.0, maximum=4.0

select fel_significant, aqp2 and resi 1+3-9+11-24+26-33+35+37-61+63-80+82-86+88-92+94-117+119-121+123-156+158-169+171-182+184-201+203-204+206-217+219-226+228-229+231-235+237-239+241-245+247-250+252-256+258-264+266-268+270-271
# show sticks, fel_significant and not name N+C+O
deselect
orient aqp2 and resi 1-271

print "AQP2 channel omega: log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16) - white at omega = 1"
print "264 coloured / 165 clipped / 245 significant (BH q <= 0.20)"

