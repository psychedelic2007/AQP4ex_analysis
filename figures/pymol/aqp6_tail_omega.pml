# PyMOL: AQP6 extension, coloured by omega (beta/alpha, shown as log2)
# generated by fel_to_pymol.py from results_final/aqp6/fel/joint_mafft.json (extension module)
#
# Reading: red = purifying (omega < 1), white = neutral, blue = diversifying
# Colour scale : log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16), white at omega = 1
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.244 to 3.27 over 11 coloured sites,
#                0 clipped at the scale limit
# Rows         : 34 human residues (11 tested). 197 columns
#                are gaps in human and are not drawn, 6 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 1 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -283
#                (284 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp6_tail_omega_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp6     # skip if --pdb was given
#   @aqp6_tail_omega.pml

alter aqp6, b = 0.0
alter aqp6 and resi 1, b = -0.4930
alter aqp6 and resi 5, b = 0.5644
alter aqp6 and resi 6, b = -1.0342
alter aqp6 and resi 7, b = -2.0350
alter aqp6 and resi 8, b = 0.0149
alter aqp6 and resi 9, b = -0.0119
alter aqp6 and resi 10, b = -0.4454
alter aqp6 and resi 11, b = 0.5015
alter aqp6 and resi 12, b = 1.0601
alter aqp6 and resi 13, b = 0.2930
alter aqp6 and resi 14, b = 1.7083

rebuild
hide everything, aqp6
show cartoon, aqp6
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp6 and resi 1+5-14
color grey70, aqp6
spectrum b, red_white_blue, fel_scored, minimum=-4.0, maximum=4.0

select fel_significant, aqp6 and resi 7
show sticks, fel_significant and not name N+C+O
deselect
orient aqp6 and resi 1-14

print "AQP6 extension omega: log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16) - white at omega = 1"
print "11 coloured / 0 clipped / 1 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp6_tail_omega.png, dpi=300
