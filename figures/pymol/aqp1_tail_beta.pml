# PyMOL: AQP1 extension, coloured by beta (non-synonymous substitution rate)
# generated by fel_to_pymol.py from results_final/aqp1/fel/joint_mafft.json (extension module)
#
# Reading: red = amino-acid changes were removed
# Colour scale : 0.000 to 1.887, shared by alpha and beta
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.372 to 5.1 over 21 coloured sites,
#                6 clipped at the scale limit
# Rows         : 85 human residues (21 tested). 355 columns
#                are gaps in human and are not drawn, 0 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 10 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -270
#                (271 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp1_tail_beta_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp1     # skip if --pdb was given
#   @aqp1_tail_beta.pml

alter aqp1, b = 0.0
alter aqp1 and resi 1, b = 0.3724
alter aqp1 and resi 2, b = 0.5555
alter aqp1 and resi 3, b = 1.0245
alter aqp1 and resi 4, b = 0.9204
alter aqp1 and resi 5, b = 1.3140
alter aqp1 and resi 6, b = 1.1034
alter aqp1 and resi 10, b = 0.5383
alter aqp1 and resi 12, b = 1.3567
alter aqp1 and resi 13, b = 0.3979
alter aqp1 and resi 14, b = 1.8865
alter aqp1 and resi 15, b = 0.8413
alter aqp1 and resi 16, b = 1.1236
alter aqp1 and resi 17, b = 1.3690
alter aqp1 and resi 18, b = 1.3672
alter aqp1 and resi 19, b = 1.8865
alter aqp1 and resi 20, b = 1.8403
alter aqp1 and resi 21, b = 1.8865
alter aqp1 and resi 27, b = 1.8865
alter aqp1 and resi 28, b = 1.8865
alter aqp1 and resi 29, b = 1.8865
alter aqp1 and resi 30, b = 1.1313

rebuild
hide everything, aqp1
show cartoon, aqp1
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp1 and resi 1-6+10+12-21+27-30
color grey70, aqp1
spectrum b, red_white, fel_scored, minimum=0.0, maximum=1.8865031212514332

select fel_significant, aqp1 and resi 2+6+10+13+15-16+21+27-28+30
show sticks, fel_significant and not name N+C+O
deselect
orient aqp1 and resi 1-30

print "AQP1 extension beta: 0.000 to 1.887 - shared by alpha and beta"
print "21 coloured / 6 clipped / 10 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp1_tail_beta.png, dpi=300
