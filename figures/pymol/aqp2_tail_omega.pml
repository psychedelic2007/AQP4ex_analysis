# PyMOL: AQP2 extension, coloured by omega (beta/alpha, shown as log2)
# generated by fel_to_pymol.py from results_final/aqp2/fel/joint_mafft.json (extension module)
#
# Reading: red = purifying (omega < 1), white = neutral, blue = diversifying
# Colour scale : log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16), white at omega = 1
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.0393 to 1.53 over 16 coloured sites,
#                1 clipped at the scale limit
# Rows         : 29 human residues (16 tested). 385 columns
#                are gaps in human and are not drawn, 14 of them were tested
#                and 2 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 6 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -272
#                (273 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp2_tail_omega_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp2     # skip if --pdb was given
#   @aqp2_tail_omega.pml

alter aqp2, b = 0.0
alter aqp2 and resi 1, b = -1.6395
alter aqp2 and resi 2, b = -0.9687
alter aqp2 and resi 3, b = -0.9234
alter aqp2 and resi 6, b = -0.7892
alter aqp2 and resi 7, b = -1.5371
alter aqp2 and resi 8, b = -0.0122
alter aqp2 and resi 9, b = -3.7416
alter aqp2 and resi 19, b = -0.3371
alter aqp2 and resi 20, b = -0.7786
alter aqp2 and resi 21, b = 0.0759
alter aqp2 and resi 22, b = -4.0000
alter aqp2 and resi 23, b = 0.1091
alter aqp2 and resi 24, b = -1.0170
alter aqp2 and resi 26, b = 0.6154
alter aqp2 and resi 27, b = -3.8847
alter aqp2 and resi 28, b = -0.3204

rebuild
hide everything, aqp2
show cartoon, aqp2
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp2 and resi 1-3+6-9+19-24+26-28
color grey70, aqp2
spectrum b, red_white_blue, fel_scored, minimum=-4.0, maximum=4.0

select fel_significant, aqp2 and resi 1+7+9+22+24+27
show sticks, fel_significant and not name N+C+O
deselect
orient aqp2 and resi 1-28

print "AQP2 extension omega: log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16) - white at omega = 1"
print "16 coloured / 1 clipped / 6 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp2_tail_omega.png, dpi=300
