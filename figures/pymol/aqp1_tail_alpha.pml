# PyMOL: AQP1 extension, coloured by alpha (synonymous substitution rate)
# generated by fel_to_pymol.py from results_final/aqp1/fel/joint_mafft.json (extension module)
#
# Reading: blue = substitutions reached this site freely. Alpha is the internal control: low beta is evidence only where alpha is high
# Colour scale : 0.000 to 1.887, shared by alpha and beta
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.224 to 2.89 over 21 coloured sites,
#                8 clipped at the scale limit
# Rows         : 85 human residues (21 tested). 355 columns
#                are gaps in human and are not drawn, 0 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 10 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -270
#                (271 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp1_tail_alpha_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp1     # skip if --pdb was given
#   @aqp1_tail_alpha.pml

alter aqp1, b = 0.0
alter aqp1 and resi 1, b = 0.6385
alter aqp1 and resi 2, b = 1.5903
alter aqp1 and resi 3, b = 0.7850
alter aqp1 and resi 4, b = 1.1715
alter aqp1 and resi 5, b = 1.4831
alter aqp1 and resi 6, b = 1.8865
alter aqp1 and resi 10, b = 1.5110
alter aqp1 and resi 12, b = 1.8865
alter aqp1 and resi 13, b = 1.8865
alter aqp1 and resi 14, b = 1.5102
alter aqp1 and resi 15, b = 1.8865
alter aqp1 and resi 16, b = 1.8865
alter aqp1 and resi 17, b = 1.1721
alter aqp1 and resi 18, b = 1.1419
alter aqp1 and resi 19, b = 1.8865
alter aqp1 and resi 20, b = 1.2087
alter aqp1 and resi 21, b = 0.6732
alter aqp1 and resi 27, b = 0.2235
alter aqp1 and resi 28, b = 0.7798
alter aqp1 and resi 29, b = 1.8865
alter aqp1 and resi 30, b = 1.8865

rebuild
hide everything, aqp1
show cartoon, aqp1
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp1 and resi 1-6+10+12-21+27-30
color grey70, aqp1
spectrum b, white_blue, fel_scored, minimum=0.0, maximum=1.8865031212514332

select fel_significant, aqp1 and resi 2+6+10+13+15-16+21+27-28+30
show sticks, fel_significant and not name N+C+O
deselect
orient aqp1 and resi 1-30

print "AQP1 extension alpha: 0.000 to 1.887 - shared by alpha and beta"
print "21 coloured / 8 clipped / 10 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp1_tail_alpha.png, dpi=300
