# PyMOL: AQP2 channel, coloured by beta (non-synonymous substitution rate)
# generated by fel_to_pymol.py from results_final/aqp2/fel/joint_mafft.json (channel module)
#
# Reading: red = amino-acid changes were removed
# Colour scale : 0.000 to 1.887, shared by alpha and beta
#                identical for every gene and region, so panels compare directly
# Raw range    : 2.61e-10 to 0.425 over 264 coloured sites,
#                0 clipped at the scale limit
# Rows         : 271 human residues (264 tested). 0 columns
#                are gaps in human and are not drawn, 0 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : off (245 significant, BH q <= 0.20, --sticks on to draw)
# Numbering    : structure resi = human reference number +0
#                (1 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp2_channel_beta_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp2     # skip if --pdb was given
#   @aqp2_channel_beta.pml

alter aqp2, b = 0.0
alter aqp2 and resi 1, b = 0.0271
