# PyMOL: AQP8 extension, coloured by omega (beta/alpha, shown as log2)
# generated by fel_to_pymol.py from results_final/aqp8/fel/joint_mafft.json (extension module)
#
# Reading: red = purifying (omega < 1), white = neutral, blue = diversifying
# Colour scale : log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16), white at omega = 1
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.0771 to 1.39 over 19 coloured sites,
#                0 clipped at the scale limit
# Rows         : 19 human residues (19 tested). 486 columns
#                are gaps in human and are not drawn, 4 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 4 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -262
#                (263 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp8_tail_omega_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp8     # skip if --pdb was given
#   @aqp8_tail_omega.pml

alter aqp8, b = 0.0
alter aqp8 and resi 1, b = -0.6619
alter aqp8 and resi 2, b = 0.4777
alter aqp8 and resi 3, b = 0.3854
alter aqp8 and resi 4, b = -0.4773
alter aqp8 and resi 5, b = -0.3530
alter aqp8 and resi 6, b = -0.2231
alter aqp8 and resi 7, b = -2.9290
alter aqp8 and resi 8, b = -0.3822
alter aqp8 and resi 9, b = -0.5650
alter aqp8 and resi 10, b = -3.6978
alter aqp8 and resi 11, b = -0.5730
alter aqp8 and resi 12, b = -0.2925
alter aqp8 and resi 13, b = -0.6514
alter aqp8 and resi 14, b = 0.3874
alter aqp8 and resi 15, b = -1.5865
alter aqp8 and resi 16, b = -2.8029
alter aqp8 and resi 17, b = -0.4546
alter aqp8 and resi 18, b = -0.2249
alter aqp8 and resi 19, b = -0.4841

rebuild
hide everything, aqp8
show cartoon, aqp8
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp8 and resi 1-19
color grey70, aqp8
spectrum b, red_white_blue, fel_scored, minimum=-4.0, maximum=4.0

select fel_significant, aqp8 and resi 7+10+15-16
show sticks, fel_significant and not name N+C+O
deselect
orient aqp8 and resi 1-19

print "AQP8 extension omega: log2(omega) from -4.0 to +4.0 (omega 0.0625 to 16) - white at omega = 1"
print "19 coloured / 0 clipped / 4 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp8_tail_omega.png, dpi=300
