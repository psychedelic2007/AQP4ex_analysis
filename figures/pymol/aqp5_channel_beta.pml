# PyMOL: AQP5 channel, coloured by beta (non-synonymous substitution rate)
# generated by fel_to_pymol.py from results_final/aqp5/fel/joint_mafft.json (channel module)
#
# Reading: red = amino-acid changes were removed
# Colour scale : 0.000 to 1.887, shared by alpha and beta
#                identical for every gene and region, so panels compare directly
# Raw range    : 9.98e-12 to 1.22 over 259 coloured sites,
#                0 clipped at the scale limit
# Rows         : 265 human residues (259 tested). 0 columns
#                are gaps in human and are not drawn, 0 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : off (246 significant, BH q <= 0.20, --sticks on to draw)
# Numbering    : structure resi = human reference number +0
#                (1 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp5_channel_beta_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp5     # skip if --pdb was given
#   @aqp5_channel_beta.pml

alter aqp5, b = 0.0
alter aqp5 and resi 2, b = 0.0981
