# PyMOL: AQP5 extension, coloured by alpha (synonymous substitution rate)
# generated by fel_to_pymol.py from results_final/aqp5/fel/joint_mafft.json (extension module)
#
# Reading: blue = substitutions reached this site freely. Alpha is the internal control: low beta is evidence only where alpha is high
# Colour scale : 0.000 to 1.887, shared by alpha and beta
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.77 to 2.03 over 11 coloured sites,
#                2 clipped at the scale limit
# Rows         : 11 human residues (11 tested). 399 columns
#                are gaps in human and are not drawn, 0 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 3 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -266
#                (267 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp5_tail_alpha_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp5     # skip if --pdb was given
#   @aqp5_tail_alpha.pml

alter aqp5, b = 0.0
alter aqp5 and resi 1, b = 0.8429
alter aqp5 and resi 2, b = 0.7701
alter aqp5 and resi 3, b = 0.8199
alter aqp5 and resi 4, b = 1.0850
alter aqp5 and resi 5, b = 0.8671
alter aqp5 and resi 6, b = 1.8865
alter aqp5 and resi 7, b = 1.6507
alter aqp5 and resi 8, b = 0.8539
alter aqp5 and resi 9, b = 1.8865
alter aqp5 and resi 10, b = 1.6770
alter aqp5 and resi 11, b = 0.8880

rebuild
hide everything, aqp5
show cartoon, aqp5
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp5 and resi 1-11
color grey70, aqp5
spectrum b, white_blue, fel_scored, minimum=0.0, maximum=1.8865031212514332

select fel_significant, aqp5 and resi 1+6+9
show sticks, fel_significant and not name N+C+O
deselect
orient aqp5 and resi 1-11

print "AQP5 extension alpha: 0.000 to 1.887 - shared by alpha and beta"
print "11 coloured / 2 clipped / 3 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp5_tail_alpha.png, dpi=300
