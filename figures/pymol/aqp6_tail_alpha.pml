# PyMOL: AQP6 extension, coloured by alpha (synonymous substitution rate)
# generated by fel_to_pymol.py from results_final/aqp6/fel/joint_mafft.json (extension module)
#
# Reading: blue = substitutions reached this site freely. Alpha is the internal control: low beta is evidence only where alpha is high
# Colour scale : 0.000 to 1.887, shared by alpha and beta
#                identical for every gene and region, so panels compare directly
# Raw range    : 0.89 to 2.34 over 11 coloured sites,
#                4 clipped at the scale limit
# Rows         : 34 human residues (11 tested). 197 columns
#                are gaps in human and are not drawn, 6 of them were tested
#                and 0 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 1 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -283
#                (284 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp6_tail_alpha_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp6     # skip if --pdb was given
#   @aqp6_tail_alpha.pml

alter aqp6, b = 0.0
alter aqp6 and resi 1, b = 1.8865
alter aqp6 and resi 5, b = 1.2560
alter aqp6 and resi 6, b = 1.8865
alter aqp6 and resi 7, b = 1.8865
alter aqp6 and resi 8, b = 1.7366
alter aqp6 and resi 9, b = 1.7434
alter aqp6 and resi 10, b = 1.8865
alter aqp6 and resi 11, b = 1.3780
alter aqp6 and resi 12, b = 0.8900
alter aqp6 and resi 13, b = 1.2044
alter aqp6 and resi 14, b = 1.4454

rebuild
hide everything, aqp6
show cartoon, aqp6
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp6 and resi 1+5-14
color grey70, aqp6
spectrum b, white_blue, fel_scored, minimum=0.0, maximum=1.8865031212514332

select fel_significant, aqp6 and resi 7
show sticks, fel_significant and not name N+C+O
deselect
orient aqp6 and resi 1-14

print "AQP6 extension alpha: 0.000 to 1.887 - shared by alpha and beta"
print "11 coloured / 4 clipped / 1 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp6_tail_alpha.png, dpi=300
