# PyMOL script — conservation of the aqp4_extension_conservation positions
# generated by seqlogo.py (mode=ref, score=identity)
#
# Score: identity of the commonest residue (%)
# Range in this dataset: 30.465 to 99.235
# Positions: 1-28 (28 residues)
#
# USAGE
#   1. Load your structure first, or edit the `load` line below.
#   2. @aqp4_extension_conservation.pml
#
# IMPORTANT
#   Residue numbering below follows --offset 0. It must match the
#   numbering in your structure file. If your model numbers the extension
#   from 1, rerun with --offset 0, or renumber the structure:
#       alter polymer, resi=str(int(resi)+0)
#   Positions absent from the alignment are left at B = -1 and coloured grey,
#   so unmodelled or unscored residues are visibly distinct from conserved ones.

# load aqp4.pdb, aqp4          # uncomment and edit if not already loaded

# --- reset B-factors so unscored residues are identifiable ----------------
alter aqp4, b = -1.0

# --- per-residue conservation --------------------------------------------
alter aqp4 and resi 1, b = 98.0916
alter aqp4 and resi 2, b = 43.1298
alter aqp4 and resi 3, b = 55.3435
alter aqp4 and resi 4, b = 58.3170
alter aqp4 and resi 5, b = 80.6641
alter aqp4 and resi 6, b = 92.3518
alter aqp4 and resi 7, b = 73.3480
alter aqp4 and resi 8, b = 83.1111
alter aqp4 and resi 9, b = 48.7751
alter aqp4 and resi 10, b = 38.1696
alter aqp4 and resi 11, b = 69.6429
alter aqp4 and resi 12, b = 30.4651
alter aqp4 and resi 13, b = 40.5941
alter aqp4 and resi 14, b = 42.7184
alter aqp4 and resi 15, b = 79.2553
alter aqp4 and resi 16, b = 45.9330
alter aqp4 and resi 17, b = 79.2237
alter aqp4 and resi 18, b = 36.2187
alter aqp4 and resi 19, b = 75.6152
alter aqp4 and resi 20, b = 77.5056
alter aqp4 and resi 21, b = 83.2599
alter aqp4 and resi 22, b = 85.9031
alter aqp4 and resi 23, b = 85.6597
alter aqp4 and resi 24, b = 99.2352
alter aqp4 and resi 25, b = 99.2352
alter aqp4 and resi 26, b = 84.1300
alter aqp4 and resi 27, b = 94.0613
alter aqp4 and resi 28, b = 90.6459

# --- display --------------------------------------------------------------
hide everything, aqp4
show cartoon, aqp4
set cartoon_transparency, 0.0

# grey for anything without a score
color grey70, aqp4 and b < 0

# spectrum over the scored range only
spectrum b, blue_white_red, aqp4 and b > -0.5, minimum=0.0, maximum=100.0

# highlight the scored region
select scored, aqp4 and resi 1-28
show sticks, scored and not (name C+N+O)
set cartoon_side_chain_helper, 1
deselect

bg_color white
set ray_opaque_background, 0
orient scored

# --- optional: label the most conserved positions -------------------------
# select topcons, aqp4 and b > 82.043
# label topcons and name CA, "%s%s" % (one_letter[resn], resi)
# set label_size, 14

# --- optional: write the B-factors back out -------------------------------
# save aqp4_conservation.pdb, aqp4

print "conservation loaded: identity of the commonest residue (%)"
print "scored residues 1-28, B range 30.465-99.235"
print "unscored residues have B = -1 and are coloured grey70"
