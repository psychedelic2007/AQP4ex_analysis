# PyMOL: AQP2 extension, coloured by alpha (synonymous substitution rate)
# generated by fel_to_pymol.py from results_final/aqp2/fel/joint_mafft.json (extension module)
#
# Reading: blue = substitutions reached this site freely. Alpha is the internal control: low beta is evidence only where alpha is high
# Colour scale : 0.000 to 1.887, shared by alpha and beta
#                identical for every gene and region, so panels compare directly
# Raw range    : 1.01 to 3.73 over 16 coloured sites,
#                11 clipped at the scale limit
# Rows         : 29 human residues (16 tested). 385 columns
#                are gaps in human and are not drawn, 14 of them were tested
#                and 2 significant, so they are missing from this figure.
# Grey         : not tested
# Sticks       : 6 significant sites (BH q <= 0.20)
# Numbering    : structure resi = human reference number -272
#                (273 -> 1), set by --resi-shift
# B-factor     : the displayed value, not the raw rate, raw values in aqp2_tail_alpha_sites.tsv
#
# USAGE (in PyMOL)
#   load <structure>.pdb, aqp2     # skip if --pdb was given
#   @aqp2_tail_alpha.pml

alter aqp2, b = 0.0
alter aqp2 and resi 1, b = 1.0110
alter aqp2 and resi 2, b = 1.5023
alter aqp2 and resi 3, b = 1.8865
alter aqp2 and resi 6, b = 1.8865
alter aqp2 and resi 7, b = 1.8865
alter aqp2 and resi 8, b = 1.8865
alter aqp2 and resi 9, b = 1.8865
alter aqp2 and resi 19, b = 1.4792
alter aqp2 and resi 20, b = 1.8865
alter aqp2 and resi 21, b = 1.8865
alter aqp2 and resi 22, b = 1.7361
alter aqp2 and resi 23, b = 1.8865
alter aqp2 and resi 24, b = 1.8865
alter aqp2 and resi 26, b = 1.8834
alter aqp2 and resi 27, b = 1.8865
alter aqp2 and resi 28, b = 1.8865

rebuild
hide everything, aqp2
show cartoon, aqp2
bg_color white
set ray_opaque_background, 0
set cartoon_side_chain_helper, 1

select fel_scored, aqp2 and resi 1-3+6-9+19-24+26-28
color grey70, aqp2
spectrum b, white_blue, fel_scored, minimum=0.0, maximum=1.8865031212514332

select fel_significant, aqp2 and resi 1+7+9+22+24+27
show sticks, fel_significant and not name N+C+O
deselect
orient aqp2 and resi 1-28

print "AQP2 extension alpha: 0.000 to 1.887 - shared by alpha and beta"
print "16 coloured / 11 clipped / 6 significant (BH q <= 0.20)"

# --- optional -------------------------------------------------------------
# ray 1600, 1200
# png aqp2_tail_alpha.png, dpi=300
